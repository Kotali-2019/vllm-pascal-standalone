 __device__ __forceinline__ void store_release_system(uint32_t* ptr,
                                                      uint32_t value) {
+#if defined(__CUDA_ARCH__) && __CUDA_ARCH__ >= 700
   uint64_t address = reinterpret_cast<uint64_t>(ptr);
   asm volatile("st.global.release.sys.u32 [%0], %1;"
                :
                : "l"(address), "r"(value)
                : "memory");
+#else
+  // sm_60/sm_61 (Pascal) lack the .release memory-ordering modifier
+  // (requires sm_70+). DCP is a sm_90+ (multimem) feature, so fail loud
+  // if this path is ever reached on Pascal.
+  asm volatile("trap;");
+#endif
 }
 
